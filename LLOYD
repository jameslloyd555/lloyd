    <!-- SECTION 2: INTRODUCTION TO COMPUTING -->
    <section id="fundamentals" class="py-20 relative border-t border-slate-800/60">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-xs font-mono font-bold text-cyber-blue tracking-widest uppercase mb-3">Module 01</h2>
                <h3 class="text-3xl sm:text-4xl font-extrabold text-white">What is Computing?</h3>
                <p class="mt-4 text-slate-400 leading-relaxed">
                    Computing is the process of using computer technology to complete a given goal-oriented task. It involves both hardware design and software development to calculate, process data, and solve problems.
                </p>
            </div>

            <!-- Fundamental Pillars Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
                <!-- Hardware Card -->
                <div class="glass-card p-8 rounded-2xl border-t-4 border-t-cyber-blue relative overflow-hidden group">
                    <div class="flex items-center justify-between mb-6">
                        <div class="w-12 h-12 rounded-xl bg-cyber-blue/10 border border-cyber-blue/30 flex items-center justify-center text-cyber-blue text-xl">
                            <i class="fa-solid fa-microchip"></i>
                        </div>
                        <span class="text-xs font-mono text-slate-500 uppercase">Physical Layer</span>
                    </div>
                    <h4 class="text-2xl font-bold text-white mb-3">Hardware</h4>
                    <p class="text-slate-400 text-sm leading-relaxed mb-6">
                        The tangible, physical components of a computer system. Hardware executes the low-level electrical signals that perform logic operations and store data.
                    </p>
                    <ul class="space-y-2 text-xs font-mono text-slate-300">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-cyber-blue"></i> Central Processing Unit (CPU)</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-cyber-blue"></i> Primary Memory (RAM, ROM)</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-cyber-blue"></i> Secondary Storage (SSD, HDD)</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-cyber-blue"></i> Input/Output Devices (Keyboards, Displays)</li>
                    </ul>
                </div>

                <!-- Software Card -->
                <div class="glass-card p-8 rounded-2xl border-t-4 border-t-cyber-purple relative overflow-hidden group">
                    <div class="flex items-center justify-between mb-6">
                        <div class="w-12 h-12 rounded-xl bg-cyber-purple/10 border border-cyber-purple/30 flex items-center justify-center text-cyber-purple text-xl">
                            <i class="fa-solid fa-code"></i>
                        </div>
                        <span class="text-xs font-mono text-slate-500 uppercase">Logical Layer</span>
                    </div>
                    <h4 class="text-2xl font-bold text-white mb-3">Software</h4>
                    <p class="text-slate-400 text-sm leading-relaxed mb-6">
                        The intangible set of instructions, data, or programs used to operate computers and execute specific tasks. It bridges human intent with raw hardware capabilities.
                    </p>
                    <ul class="space-y-2 text-xs font-mono text-slate-300">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-cyber-purple"></i> System Software (Operating Systems, Drivers)</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-cyber-purple"></i> Application Software (Browsers, Games, IDEs)</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-cyber-purple"></i> Programming Languages (Python, C++, Java)</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-cyber-purple"></i> Utility Software (Antivirus, Compressors)</li>
                    </ul>
                </div>
            </div>

            <!-- The Information Processing Cycle (IPOS) -->
            <div class="glass-card p-8 sm:p-10 rounded-2xl">
                <h4 class="text-xl font-bold text-white mb-2 text-center sm:text-left">The Information Processing Cycle (IPOS)</h4>
                <p class="text-slate-400 text-sm mb-8 text-center sm:text-left">Every general-purpose computer operates on four essential steps:</p>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative">
                    <!-- Step 1: Input -->
                    <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-800 text-center relative">
                        <div class="w-8 h-8 rounded-full bg-blue-500/20 text-blue-400 font-mono font-bold text-sm flex items-center justify-center mx-auto mb-3">1</div>
                        <h5 class="text-white font-bold mb-1">INPUT</h5>
                        <p class="text-slate-400 text-xs">Receives raw data from user or sensors (e.g., Keystrokes, Mic, Mouse click).</p>
                    </div>

                    <!-- Step 2: Processing -->
                    <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-800 text-center relative">
                        <div class="w-8 h-8 rounded-full bg-cyber-purple/20 text-cyber-purple font-mono font-bold text-sm flex items-center justify-center mx-auto mb-3">2</div>
                        <h5 class="text-white font-bold mb-1">PROCESSING</h5>
                        <p class="text-slate-400 text-xs">CPU manipulates raw input into meaningful information using logic gates.</p>
                    </div>

                    <!-- Step 3: Output -->
                    <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-800 text-center relative">
                        <div class="w-8 h-8 rounded-full bg-cyber-pink/20 text-cyber-pink font-mono font-bold text-sm flex items-center justify-center mx-auto mb-3">3</div>
                        <h5 class="text-white font-bold mb-1">OUTPUT</h5>
                        <p class="text-slate-400 text-xs">Displays or sends processed results back to the user (e.g., Screen, Speakers).</p>
                    </div>

                    <!-- Step 4: Storage -->
                    <div class="bg-slate-900/80 p-5 rounded-xl border border-slate-800 text-center relative">
                        <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 font-mono font-bold text-sm flex items-center justify-center mx-auto mb-3">4</div>
                        <h5 class="text-white font-bold mb-1">STORAGE</h5>
                        <p class="text-slate-400 text-xs">Saves data permanently or temporarily for future access (e.g., SSD, RAM).</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

